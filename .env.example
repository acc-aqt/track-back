# Template for a TrackBack config file.
# The easier path: run `track-back-server init`, which writes the per-user config file.
# To use this template instead, copy it to .env in the directory you start the
# server from (or pass it with --env-file) and fill in the values.

# Port the server listens on (optional, default 4200).
# The --port command line option takes precedence.
PORT=4200

# Music Service the server uses: applemusic, spotify or mock (optional).
# Default: applemusic on macOS, spotify elsewhere.
# The --music-service command line option takes precedence.
MUSIC_SERVICE=

# SSL Configuration (optional)
# Provide these paths to enable HTTPS for your server
# Make sure the files exist and are accessible at runtime

# Path to your private key file (e.g., key.pem)
SSL_KEYFILE=

# Path to your certificate file (e.g., cert.pem)
SSL_CERTFILE=

# The following parameters can be obtained 
# from the "spotify for developers" dashboard 
# (https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=your-client-id
SPOTIPY_CLIENT_SECRET=your-client-secret
SPOTIPY_REDIRECT_URI=your-redirect-uri