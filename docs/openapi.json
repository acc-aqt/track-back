{
  "openapi": "3.1.0",
  "info": {
    "title": "TrackBack",
    "version": "0.1.0"
  },
  "paths": {
    "/create": {
      "post": {
        "summary": " Create Game Session",
        "operationId": "_create_game_session_create_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/list-sessions": {
      "get": {
        "summary": " List Joinable Game Sessions",
        "operationId": "_list_joinable_game_sessions_list_sessions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/music-services": {
      "get": {
        "summary": " List Music Services",
        "operationId": "_list_music_services_music_services_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MusicServicesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/covers/{cover_id}": {
      "get": {
        "summary": " Get Cover",
        "operationId": "_get_cover_covers__cover_id__get",
        "parameters": [
          {
            "name": "cover_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cover Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/jpeg": {}
            }
          },
          "404": {
            "description": "Unknown cover."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/join": {
      "post": {
        "summary": " Join Game Session",
        "operationId": "_join_game_session_join_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinGameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/start": {
      "post": {
        "summary": " Start Game Session",
        "description": "Start the game and notify the first player via WebSocket.",
        "operationId": "_start_game_session_start_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartGameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/spotify-login": {
      "get": {
        "summary": "Spotify Login",
        "description": "Initiate the Spotify OAuth authorization flow.\n\nThis endpoint generates an authorization URL and redirects the user to Spotify's\nlogin and consent page. An optional 'state' parameter can be passed to track the\nsession or pass metadata, which will be included in the callback.\n\nParameters\n----------\nstate : str, optional\n    A JSON-encoded string to maintain state between the request and callback.\n    Defaults to an empty string.\n\nReturns\n-------\nRedirectResponse\n    A redirect to Spotify's authorization URL where the user can log in and\n    authorize access.",
        "operationId": "spotify_login_spotify_login_get",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "State"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/spotify-callback": {
      "get": {
        "summary": "Spotify Callback",
        "description": "Handle the Spotify OAuth callback after user authorization.\n\nThis endpoint is triggered by Spotify after a user logs in and approves access. It\nextracts the authorization code and the game configuration state (game ID, target\nsong count) from the request, exchanges the code for an access token, retrieves the\nuser profile, sets up the game logic with a Spotify adapter, and registers the new\ngame session.\n\nParameters\n----------\nrequest : Request\n    The incoming request containing query parameters 'code' and 'state'.\n\nReturns\n-------\nHTMLResponse\n    A success message if login and setup succeeded, or an error message if any\n    part of the process failed.",
        "operationId": "spotify_callback_spotify_callback_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateGameRequest": {
        "properties": {
          "game_id": {
            "type": "string",
            "title": "Game Id"
          },
          "target_song_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Target Song Count"
          },
          "music_service_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MusicServiceType"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "game_id",
          "target_song_count"
        ],
        "title": "CreateGameRequest",
        "description": "Request model for creating a game session."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JoinGameRequest": {
        "properties": {
          "game_id": {
            "type": "string",
            "title": "Game Id"
          },
          "user_name": {
            "type": "string",
            "title": "User Name"
          }
        },
        "type": "object",
        "required": [
          "game_id",
          "user_name"
        ],
        "title": "JoinGameRequest",
        "description": "Request model for joining a game session."
      },
      "MusicServiceType": {
        "type": "string",
        "enum": [
          "spotify",
          "applemusic",
          "mock"
        ],
        "title": "MusicServiceType",
        "description": "Music services a game can be created with."
      },
      "MusicServicesResponse": {
        "properties": {
          "default": {
            "$ref": "#/components/schemas/MusicServiceType"
          },
          "available": {
            "items": {
              "$ref": "#/components/schemas/MusicServiceType"
            },
            "type": "array",
            "title": "Available"
          }
        },
        "type": "object",
        "required": [
          "default",
          "available"
        ],
        "title": "MusicServicesResponse",
        "description": "The Music Services a Host can create a Game Session with."
      },
      "StartGameRequest": {
        "properties": {
          "game_id": {
            "type": "string",
            "title": "Game Id"
          }
        },
        "type": "object",
        "required": [
          "game_id"
        ],
        "title": "StartGameRequest",
        "description": "Request model for starting a game session."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
